# Copy to .env and fill in the real values, then build with:
#   make PRIVATE=1 all
#
# .env is gitignored and must never be committed. Without it (or with any
# value below left empty) latexmk silently builds the public CV instead.
#
# The private build also needs picture.png in the repo root (\photo).

# Your mobile number, shown in the CV header.
PHONE_NUMBER=+39 123 4567890

# Referees' phone numbers, shown in the "References" section.
LUIGI_NUMBER=+39 123 4567890
MARCO_NUMBER=+39 123 4567890
